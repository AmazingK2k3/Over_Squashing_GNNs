# Copy this file to .env and adjust for your local machine.
# .env is gitignored, so these values never get committed.

# Absolute path to the gnn-comparison directory (defaults to this file's location if unset)
PROJECT_ROOT=/absolute/path/to/gnn-comparison

# Optional overrides; default to PROJECT_ROOT/DATA and PROJECT_ROOT/results
# DATA_DIR=/absolute/path/to/gnn-comparison/DATA
# RESULTS_DIR=/absolute/path/to/gnn-comparison/results
